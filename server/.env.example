# AI API Keys
# Get your API keys from the respective providers:

# Google AI (Gemini) - https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (GPT models) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude models) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (Local LLM)
# Model path/name (default: llama2)
OLLAMA_MODEL_PATH=llama2
# Batch size for processing (default: 10)
OLLAMA_BATCH_SIZE=10
# Model parameters
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1

# Optional: Other providers (not yet implemented)
# COHERE_API_KEY=your_cohere_api_key_here
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Server Configuration
PORT=5000 